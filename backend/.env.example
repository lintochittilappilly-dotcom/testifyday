# ===== MongoDB Atlas =====
MONGO_URL=mongodb+srv://USER:PASS@cluster.mongodb.net/?retryWrites=true&w=majority
DB_NAME=testifyday

# ===== Auth =====
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@testify.day
ADMIN_PASSWORD=change-me-strong

# ===== Google OAuth (from Google Cloud Console) =====
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

# ===== CORS / frontend origin(s), comma-separated. First one is used in emails. =====
CORS_ORIGINS=https://www.testify.day,https://testify.day

# ===== Email (Resend) =====
RESEND_API_KEY=re_xxx
SENDER_EMAIL=no-reply@testify.day

# ===== Stripe =====
STRIPE_SECRET_KEY=sk_live_or_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ===== reCAPTCHA v2 =====
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ===== AWS S3 (uploads) =====
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=testify-uploads
# Optional: leave blank if using API-proxied media; set to CloudFront or public bucket URL
S3_PUBLIC_URL=
# Optional: only set for Cloudflare R2 / MinIO. Leave blank for AWS.
S3_ENDPOINT_URL=
